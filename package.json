{
  "name": "schway",
  "version": "1.0.0-rc.2",
  "description": "A lean, light, fast, and hackable coding-agent harness",
  "type": "module",
  "license": "MIT",
  "bin": {
    "schway": "./bin/schway"
  },
  "exports": {
    "./host": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./src/host/index.ts"
    },
    "./extensions": {
      "types": "./dist/types/extensions/index.d.ts",
      "default": "./src/extensions/index.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "examples/extensions",
    "examples/packages",
    "docs/live-providers.md",
    "docs/doctor.md",
    "docs/configuration.md",
    "docs/credentials.md",
    "docs/diagnostics.md",
    "docs/evals.md",
    "docs/extensions.md",
    "docs/headless.md",
    "docs/host.md",
    "docs/tools.md",
    "docs/skills.md",
    "docs/sessions.md",
    "docs/stability.md",
    "docs/tui.md",
    "docs/workspaces.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/types"
  ],
  "scripts": {
    "dev": "bun --no-env-file src/cli/main.ts",
    "start": "bun --no-env-file src/cli/main.ts",
    "live-smoke": "bun --no-env-file src/live/cli.ts",
    "eval": "bun --no-env-file src/eval/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "screens:update": "SCHWAY_UPDATE_SCREENS=1 bun test tests/screen-catalog.test.ts",
    "screens:gallery": "bun tests/screen-catalog/gallery.ts",
    "screens:sweep": "SCHWAY_SCREEN_SWEEP=1 bun test tests/screen-sweep.test.ts",
    "demo:record": "vhs docs/demo/demo.tape",
    "prepack": "bun scripts/build-extension-types.ts"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@opentui/core": "^0.5.11",
    "@sinclair/typebox": "^0.34.52",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "openai": "^7.20.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.3",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
