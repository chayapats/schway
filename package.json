{
  "name": "schway",
  "version": "0.1.0",
  "description": "A lean, light, fast, and hackable coding-agent harness",
  "type": "module",
  "license": "MIT",
  "bin": {
    "schway": "./bin/schway"
  },
  "exports": {
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "default": "./src/extensions/index.ts"
    }
  },
  "files": [
    "bin",
    "src",
    "examples/extensions",
    "examples/packages",
    "docs/live-providers.md",
    "docs/doctor.md",
    "docs/configuration.md",
    "docs/credentials.md",
    "docs/diagnostics.md",
    "docs/evals.md",
    "docs/extensions.md",
    "docs/sessions.md",
    "docs/workspaces.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun --no-env-file src/cli/main.ts",
    "start": "bun --no-env-file src/cli/main.ts",
    "live-smoke": "bun --no-env-file src/live/cli.ts",
    "eval": "bun --no-env-file src/eval/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@opentui/core": "^0.5.11",
    "@sinclair/typebox": "^0.34.52",
    "@types/semver": "^7.8.0",
    "ajv": "^8.20.0",
    "openai": "^7.20.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
