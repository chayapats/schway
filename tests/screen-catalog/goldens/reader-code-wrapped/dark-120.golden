  Read code · ts                                                                                        Lines 1–5 of 5
  1 export function summarize(rows: readonly Row[], options: { locale: string; currency: string; includeArchived: bool
    ean; precision: number; groupBy: "region" | "owner"; timezone: string }): Summary {
  2   const label = 'สรุปยอดขาย 🧪 ' + options.locale; // Thai and emoji stay whole graphemes when the view pans or wra
    ps
  3   const totals = rows.filter(row => options.includeArchived || !row.archived).map(row => row.amount * row.quantity
    );
  4   return { label, total: totals.reduce((sum, value) => sum + value, 0).toFixed(options.precision), currency: optio
    ns.currency };
  5 }
















