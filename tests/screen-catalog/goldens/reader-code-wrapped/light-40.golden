screen reader-code-wrapped
title Read code, wrapped
description W wraps long code lines in the reader while line numbers keep each source line.
variant light-40
size 40x30
cursor 1 1 hidden
== text
 ⚡ schway  /project

 Read code · ts          Lines 1–5 of 5
 1 export function summarize(rows: read
   only Row[], options: { locale: strin
   g; currency: string; includeArchived
   : boolean; precision: number; groupB
   y: "region" | "owner"; timezone: str
   ing }): Summary {
 2   const label = 'สรุปยอดขาย 🧪 ' + op
   tions.locale; // Thai and emoji stay
    whole graphemes when the view pans
   or wraps
 3   const totals = rows.filter(row =>
   options.includeArchived || !row.arch
   ived).map(row => row.amount * row.qu
   antity);
 4   return { label, total: totals.redu
   ce((sum, value) => sum + value, 0).t
   oFixed(options.precision), currency:
    options.currency };
 5 }






