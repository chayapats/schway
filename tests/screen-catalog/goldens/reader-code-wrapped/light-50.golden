 ⚡ schway  /project

 Read code · ts                    Lines 1–5 of 5
 1 export function summarize(rows: readonly Row[]
   , options: { locale: string; currency: string;
    includeArchived: boolean; precision: number;
   groupBy: "region" | "owner"; timezone: string
   }): Summary {
 2   const label = 'สรุปยอดขาย 🧪 ' + options.loca
   le; // Thai and emoji stay whole graphemes whe
   n the view pans or wraps
 3   const totals = rows.filter(row => options.in
   cludeArchived || !row.archived).map(row => row
   .amount * row.quantity);
 4   return { label, total: totals.reduce((sum, v
   alue) => sum + value, 0).toFixed(options.preci
   sion), currency: options.currency };
 5 }










