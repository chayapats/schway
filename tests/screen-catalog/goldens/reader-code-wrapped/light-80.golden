schway-screen 1
screen reader-code-wrapped
title Read code, wrapped
description W wraps long code lines in the reader while line numbers keep each source line.
variant light-80
size 80x30
cursor 1 1 hidden
== text
 ⚡ schway  /project

  Read code · ts                                                Lines 1–5 of 5
  1 export function summarize(rows: readonly Row[], options: { locale: string;
     currency: string; includeArchived: boolean; precision: number; groupBy: "
    region" | "owner"; timezone: string }): Summary {
  2   const label = 'สรุปยอดขาย 🧪 ' + options.locale; // Thai and emoji stay w
    hole graphemes when the view pans or wraps
  3   const totals = rows.filter(row => options.includeArchived || !row.archiv
    ed).map(row => row.amount * row.quantity);
  4   return { label, total: totals.reduce((sum, value) => sum + value, 0).toF
    ixed(options.precision), currency: options.currency };
  5 }















